# Copia este archivo a .env y coloca la clave de tu proveedor.
# NUNCA subas el .env real al repositorio.

# Proveedor LLM: deepseek (por defecto, el más económico) | openai | anthropic
LLM_PROVIDER=deepseek

# --- Clave según el proveedor elegido ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo (opcional). Por defecto: deepseek-chat | gpt-4o-mini | claude-sonnet-4-6
# DYNARE_MODEL=deepseek-chat
